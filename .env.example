# ==========================================
# CHAVES DA INTELIGÊNCIA ARTIFICIAL
# ==========================================
# Crie sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# ==========================================
# CHAVES DO TELEGRAM
# ==========================================
# Fale com o @BotFather no Telegram para criar um bot e pegar o Token
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_aqui

# ==========================================
# CHAVES DO GITHUB E CONFIGURAÇÃO DO REPOSITÓRIO
# ==========================================
# Crie um Personal Access Token em: https://github.com/settings/tokens
GITHUB_TOKEN=seu_token_do_github_aqui

# Seu nome de usuário no GitHub (Exemplo: "marcosdev")
GITHUB_REPO_OWNER=seu_usuario

# Nome do repositório onde o site está hospedado (Exemplo: "meu-site-blog")
GITHUB_REPO_NAME=nome_do_repositorio

# A pasta dentro do GitHub onde os arquivos .md ou .mdx ficam guardados
# Exemplo 1: "src/content/blog" (Astro)
# Exemplo 2: "posts" ou "content" (Next.js)
GITHUB_POSTS_FOLDER=src/content/blog
